#!/bin/bash

script_dir=$(dirname "$(realpath "$0")")

. "$script_dir/ct_launcher.sh"
. "$script_dir/mkchad-persistent-launcher.sh"
. "$script_dir/nvim_library.sh"

nvim_select_container_backend || {
  printf '%s\n' 'Neither SingularityCE nor Apptainer is available. Please install one of them.' >&2
  exit 1
}
nvim_require_container_image || exit $?

if [[ -n ${NVIM_APPNAME:-} ]]; then
  appname_mode='set'
  appname=$NVIM_APPNAME
else
  appname_mode='unset'
  appname=
fi

# Keep generic Neovim selection in the payload, not the shared profile.
mkchad_persistent_exec "$NVIM_CONTAINER_RUNTIME" "$NVIM_CONT_LOCATION" \
  --mkchad-generic-nvim "$appname_mode" "$appname" -- "$@"
