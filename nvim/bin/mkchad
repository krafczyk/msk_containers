#!/bin/bash

script_dir=$(dirname "$(realpath "$0")")

. "$script_dir/ct_launcher.sh"
. "$script_dir/nvim_library.sh"

mkchad_runtime_dir="$HOME/.local/share/mkchad/tmp"
mkchad_cache_dir="$HOME/.local/cache"
# The common host-side parent is intentionally architecture-neutral.  Each
# container selects its own architecture/Node-major subdirectory at runtime.
msk_npm_global_base="$HOME/.local/share/msk_containers/npm-global"
msk_npm_container_base="/opt/msk/npm-global"
opencode_config="$HOME/.config/mkchad/opencode.jsonc"
bootstrap="$script_dir/mkchad-container-bootstrap"

## Solve issue with Curl permissions and keep runtime caches on mounted storage.
mkdir -p "$mkchad_runtime_dir" "$mkchad_cache_dir" "$msk_npm_global_base"

# Launch MkChad inside the persistent instance that owns detached service image
# mounts after an editor exits.
ct_instance_exec=$(ct_launcher_path ct_instance_exec.sh) || exit $?
exec "$ct_instance_exec" "--$TOOL" \
  --ct-instance-root "$mkchad_runtime_dir/container-instances" \
  --ct-bind "$msk_npm_global_base:$msk_npm_container_base" \
  --ct-env "MKCHAD_PERSISTENT_INSTANCE=1" \
  --ct-env "NVIM_APPNAME=mkchad" \
  --ct-env "MKCHAD_NVIM_IMAGE=1" \
  --ct-env "XDG_RUNTIME_DIR=$mkchad_runtime_dir" \
  --ct-env "XDG_CACHE_HOME=$mkchad_cache_dir" \
  --ct-env "MSK_NPM_GLOBAL_BASE=$msk_npm_container_base" \
  --ct-env "OPENCODE_CONFIG=$opencode_config" \
  --ct-bootstrap "$bootstrap" \
  -- "$NVIM_CONT_LOCATION" nvim "$@"
