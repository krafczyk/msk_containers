#!/usr/bin/env bash

# Execute the reviewed lifecycle command from an existing MkChad image. This
# companion is invoked by both MkChad and the public host launcher.
set -euo pipefail

program=${0##*/}
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_root="$config_home/mkchad"
entrypoint="$config_root/lua/mkchad/opencode/command.lua"
runtime_dir=${XDG_RUNTIME_DIR:-"$HOME/.local/share/mkchad/tmp"}
cache_dir=${XDG_CACHE_HOME:-"$HOME/.local/cache"}
npm_container_base=/opt/msk/npm-global
opencode_config="$config_root/opencode.jsonc"
lifecycle_command=
for lifecycle_argument in "$@"; do
  [[ $lifecycle_argument == -- ]] && continue
  lifecycle_command=$lifecycle_argument
  break
done

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit "${2:-1}"
}

container_signal=${SINGULARITY_CONTAINER:-${APPTAINER_CONTAINER:-}}
[[ -n $container_signal && ( ${MKCHAD_NVIM_IMAGE:-} == 1 || ${container_signal##*/} == neovim.sif ) ]] || \
  die "this command must run inside the active MkChad image"
if [[ $lifecycle_command == start && ${MKCHAD_PERSISTENT_INSTANCE:-} != 1 ]]; then
  die "detached start requires the managed persistent container instance"
fi
if [[ $lifecycle_command == restart-broker && ${MKCHAD_PERSISTENT_INSTANCE:-} != 1 ]]; then
  die "broker restart requires the managed persistent container instance"
fi
[[ -f $entrypoint ]] || die "installed MkChad lifecycle entrypoint is missing: $entrypoint"
[[ -r $entrypoint ]] || die "installed MkChad lifecycle entrypoint is not readable: $entrypoint"

if [[ $lifecycle_command == status ]]; then
  # Status is observational; do not let Neovim create a fallback log in HOME.
  export NVIM_LOG_FILE=/dev/null
fi

export NVIM_APPNAME=mkchad
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$runtime_dir}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$cache_dir}"
export MSK_NPM_GLOBAL_BASE="${MSK_NPM_GLOBAL_BASE:-$npm_container_base}"
export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$opencode_config}"
nvim_executable=${MKCHAD_NVIM_EXECUTABLE:-}
if [[ -z $nvim_executable ]]; then
  nvim_executable=$(command -v nvim 2>/dev/null) || nvim_executable=
fi
[[ $nvim_executable == /* && -x $nvim_executable ]] || die "container Neovim is unavailable"
exec "$nvim_executable" -u NONE -l "$entrypoint" -- "$@"
