#!/usr/bin/env bash

# Select the writable tool prefix for this image, then preserve the requested
# command as the container-tools bootstrap contract requires.
set -euo pipefail

program=${0##*/}
npm_base=${MSK_NPM_GLOBAL_BASE:-/opt/msk/npm-global}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 1
}

[[ $# -gt 0 ]] || die "no command was provided"
command -v node >/dev/null 2>&1 || die "container Node.js is unavailable"
mkchad_nvim_executable=$(command -v nvim 2>/dev/null) || mkchad_nvim_executable=

if [[ ${1:-} == --mkchad-payload-cwd ]]; then
  [[ $# -ge 4 && ${3:-} == -- && $2 == /* ]] || die "invalid payload working directory arguments"
  cd -- "$2" || die "payload working directory is unavailable: $2"
  shift 3
fi
if [[ ${1:-} == --mkchad-nvim ]]; then
  [[ -n $mkchad_nvim_executable ]] || die "container Neovim is unavailable"
  shift
  set -- "$mkchad_nvim_executable" "$@"
fi

node_global_key=$(node -p \
  "process.platform + '-' + process.arch + '-node' + process.versions.node.split('.')[0]") || \
  die "unable to determine the container Node.js platform"
[[ $node_global_key =~ ^[A-Za-z0-9._-]+$ ]] || die "container Node.js returned an invalid platform key"

export MSK_NPM_GLOBAL_BASE="$npm_base"
export MSK_NPM_GLOBAL_ROOT="$npm_base/$node_global_key"
export NPM_CONFIG_PREFIX="$MSK_NPM_GLOBAL_ROOT"
export PATH="$MSK_NPM_GLOBAL_ROOT/bin:$PATH"
[[ -z $mkchad_nvim_executable ]] || export MKCHAD_NVIM_EXECUTABLE="$mkchad_nvim_executable"

# Generic launchers share the persistent MkChad profile, then replace only the
# payload environment so their caller-specific Neovim selection is not part of
# the instance identity.
if [[ ${1:-} == --mkchad-generic-nvim ]]; then
  [[ $# -ge 4 && ( $2 == set || $2 == unset ) ]] || die "invalid generic Neovim payload arguments"
  generic_nvim_mode=$2
  generic_nvim_appname=${3:-}
  [[ ${4:-} == -- ]] || die "invalid generic Neovim payload delimiter"
  shift 4
  [[ -n $mkchad_nvim_executable ]] || die "container Neovim is unavailable"
  if [[ $generic_nvim_mode == set ]]; then
    exec env "NVIM_APPNAME=$generic_nvim_appname" "$mkchad_nvim_executable" "$@"
  fi
  exec env -u NVIM_APPNAME "$mkchad_nvim_executable" "$@"
fi
if [[ ${1:-} == --mkchad-generic-shell ]]; then
  [[ $# -ge 2 && ${2:-} == -- ]] || die "invalid generic shell payload arguments"
  shift 2
  [[ $# -gt 0 ]] || set -- -i
  exec env -u NVIM_APPNAME /bin/bash "$@"
fi

exec "$@"
